RESIDENT stg_mml_prior
WHERE Exists(%typed_wbs, wbs_element)
AND NOT EXISTS([%link_key], 
	wbs_element & '|' &
	fiscal_year &
	Num(fiscal_period_month_num, '00') & '|||' &
    ApplyMap('map_wbs_opp', wbs_element, '')
);
// above is intended to supress keys already created in the fin block and avoid forcasting issues
// 10/22/2026 - CPM -  link rows for AMEP snapshot WBS that don't have one yet (the dropped WBS returned in Jan snapshot view). tmp_link_seen drops duplicate keys

// LINK 9 prep: keys already IN link_table (separate field %link_seen so the check really sees link_table only).
tmp_link_seen:
