// SECTION Tab 6 - STORE AND EXIT /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// AUTONUMBER replaces the long text keys (%link_key, nae_key) with integers in every table: smaller QVDs, faster joins.
// The numbers change every reload - never compare or hard-code them.
AUTONUMBER [%link_key], nae_key;

// Write the 14 model QVDs that the dashboard app loads.
STORE dim_date					INTO [$(vFinQvds)/dim_date.qvd](qvd);
STORE dim_version				INTO [$(vFinQvds)/dim_version.qvd](qvd);
STORE dim_wbs					INTO [$(vFinQvds)/dim_wbs.qvd](qvd);
STORE dim_profit_center			INTO [$(vFinQvds)/dim_profit_center.qvd](qvd);
STORE dim_cost_center			INTO [$(vFinQvds)/dim_cost_center.qvd](qvd);
STORE dim_nae					INTO [$(vFinQvds)/dim_nae.qvd](qvd);
STORE dim_internal_order		INTO [$(vFinQvds)/dim_internal_order.qvd](qvd);
STORE dim_opportunity           INTO [$(vFinQvds)/dim_opportunity.qvd](qvd);
STORE fact_wbs_month			INTO [$(vFinQvds)/fact_wbs_month.qvd](qvd);
STORE fact_allocation_year		INTO [$(vFinQvds)/fact_allocation_year.qvd](qvd);
STORE fact_io_month				INTO [$(vFinQvds)/fact_io_month.qvd](qvd);
STORE fact_allocation_history	INTO [$(vFinQvds)/fact_allocation_history.qvd](qvd);
STORE fact_mml_history			INTO [$(vFinQvds)/fact_mml_history.qvd](qvd);
STORE link_table 				INTO [$(vFinQvds)/link_table.qvd](qvd);

// Drop every table from this app after storing: the QVDGEN app is only a generator and keeps no data in memory.
// TableName(0) is always the first remaining table, so the loop empties the model.
LET vL.NumTabelle = NoOfTables();

FOR j=0 to $(vL.NumTabelle)-1

LET vL.nomeTabella = TableName(0);

  DROP Table [$(vL.nomeTabella)];

NEXT j;

LET vT = Now();
TRACE >>> Load complete: $(vT);

Exit Script;


