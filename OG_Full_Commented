// Staging tables are no longer needed - free the memory. Dimensions, facts and link_table remain.
DROP TABLES stg_fin, stg_alloc, stg_alloc_cur, stg_sap, stg_io_cost, stg_io_capital, stg_bnp, stg_bnp_alloc, stg_mml_prior, tmp_typed_wbs, stg_amep_plan, tmp_amep_year;

