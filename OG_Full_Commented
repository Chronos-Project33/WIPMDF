RESIDENT stg_bnp;

// LINK 8: prior-year MML month keys (source 4). NOTE: the NOT EXISTS test on [%link_key] looks at the whole field,
// which already holds every fact_wbs_month key, so this block most likely adds 0 rows. Kept as is.
CONCATENATE(link_table)
LOAD DISTINCT
	wbs_element & '|' & 
    	fiscal_year & 
        Num(fiscal_period_month_num, '00') & '|||' &
        ApplyMap('map_wbs_opp', wbs_element, '') 									AS [%link_key],
    wbs_element,
    ApplyMap('map_wbs_opp', wbs_element, '') 									AS opportunity_number,
    fiscal_year*100 + fiscal_period_month_num 									AS year_month,
